<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_tds_report_tree" model="ir.ui.view">
        <field name="name">view_tds_report_tree</field>
        <field name="model">tds.report</field>
        <field name="arch" type="xml">
            <tree editable="top" create="false" edit="false">
                <field name = 'financial_year_name' readonly="1" />
                <field name = 'partner_name' readonly="1" />
                <field name = 'partner_code' readonly="1" />
                <field name = 'pan_number' readonly="1" />
                <field name = 'pan_status' readonly="1" />
                <field name = 'percent_tds' readonly="1" />
                <field name = 'request_amount' readonly="1" />
                <field name = 'interest_amount' readonly="1" />
                <field name = 'total_purchase' readonly="1" />
                <field name = 'threshold_amount' readonly="1" />
                <field name = 'tds_assessable_calculation' readonly="1" />
                <field name = 'tds_amount_calculation' readonly="1" />
                <field name = 'tds_assessable_payment' readonly="1" />
                <field name = 'tds_amount_payment' readonly="1" />
                <field name = 'different_tds_assessable' readonly="1" />
                <field name = 'different_tds_amount' readonly="1" />
            </tree>
         </field>
    </record>

    <record id="tds_report_search_view" model="ir.ui.view">
        <field name="name">tds_report_search_view</field>
        <field name="model">tds.report</field>
        <field name="arch" type="xml">
            <search>
                <field name = "financial_year_name"/>
                <field name = "partner_name"/>
                <field name = "partner_code"/>
                <field name = "pan_number"/>
<!--                    <filter string="Has PAN Number" name="has_pan" domain="[('pan_number','!=','')]" default="1"/>-->
                <group expand="1" string="Group By">
                    <filter domain="[('pan_number','!=','')]" string="Has PAN Number" name='has_pan'/>
                </group>
            </search>
         </field>
    </record>

    <record id="action_tds_report_india" model="ir.actions.act_window">
        <field name="name">TDS Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tds.report</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_has_pan':'Has PAN'}</field>
 </record>
</odoo>