<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_report_tree" model="ir.ui.view">
            <field name="name">view_purchase_report_tree</field>
            <field name="model">purchase.report</field>
            <field name="arch" type="xml">
                <tree editable="top" create="false" edit="false">
                    <field name = 'purchase_contract_id' readonly="1" />
                    <field name = 'purchase_date' readonly="1" />
                    <field name = 'consignment_id' readonly="1" />
                    <field name = 'consignment_date' readonly="1" />
                    <field name = 'invoice_number' readonly="1" />
                    <field name = 'invoice_date' readonly="1" />
                    <field name = 'picking_id' readonly="1" />
                    <field name = 'grn_date' readonly="1" />
                    <field name = 'partner_code' readonly="1" />
                    <field name = 'partner_id' readonly="1" />
                    <field name = 'estate_name' readonly="1" />
                    <field name = 'default_code' readonly="1" />
                    <field name = 'product_id' readonly="1" />
                    <field name = 'certificate_id' readonly="1" />
                    <field name = 'crop_id' readonly="1" />
                    <field name = 'packing_id' readonly="1" />
                    <field name = 'total_bag' readonly="1" sum="total_bag"/>
                    <field name = 'gross_qty' readonly="1" sum="gross_qty"/>
                    <field name = 'quality_deduction' readonly="1" sum="quality_deduction"/>
                    <field name = 'net_qty' readonly="1" sum="net_qty"/>
                    <field name = 'net_price' readonly="1" sum="net_price"/>
                    <field name = 'premium' readonly="1" sum="premium"/>
                    <field name = 'gross_price' readonly="1" sum="gross_price"/>
                    <field name = 'gross_value' readonly="1" sum="gross_value"/>
                    <field name = 'deduction_value' readonly="1" sum="deduction_value"/>
                    <field name = 'net_value' readonly="1" sum="net_value"/>
                </tree>
             </field>
        </record>

        <record id="purchase_report_search_view" model="ir.ui.view">
            <field name="name">purchase_report_search_view</field>
            <field name="model">purchase.report</field>
            <field name="arch" type="xml">
                <search>
                    <field name = "purchase_contract_id"/>
                    <field name = "consignment_id"/>
                    <field name = "picking_id"/>
                    <field name = "partner_code"/>
                    <field name = "partner_id"/>
                    <field name = "estate_name"/>
                    <field name = "default_code"/>
                    <field name = "product_id"/>
                    <field name = "certificate_id"/>
                    <field name = "crop_id"/>
                    <field name = "packing_id"/>
                </search>
             </field>
        </record>

        <record id="action_purchase_report_india" model="ir.actions.act_window">
            <field name="name">Purchase Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.report</field>
            <field name="view_mode">tree</field>
        </record>
</odoo>