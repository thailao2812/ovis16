<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pss_management_inherit_india" model="ir.ui.view">
        <field name="name">view_pss_management_inherit_india</field>
        <field name="model">pss.management</field>
        <field name="inherit_id" ref="sd_quality.view_pss_management"/>
        <field name="arch" type="xml">
                <xpath expr="//tree" position="replace">
                    <tree editable="top" default_order="id desc">
                        <field name="file" widget="binary" filename="file_name"/>
                	    <field name="file_name" invisible="1"/>
                        <field name="warehouse_id"/>
                        <field name="s_contract_id" domain="[('state', '!=', 'cancel')]" required="1"/>
                        <field name="s_contract_date"/>
