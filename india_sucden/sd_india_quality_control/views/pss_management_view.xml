                        <field name="crop_id"/>
                        <field name="pss_type"/>
                        <field name="contract_qty"/>
                        <field name="sample_qty"/>
                        <field name="sample_sent_date"/>
                        <field name="sample_ref"/>
                        <field name="courier"/>
                        <field name="awb_no"/>
                        <field name="shipt_month"/>
                        <field name="pss_delivery_date"/>
                        <field name="pss_status"/>
                        <field name="approve_date" attrs="{'required': [('pss_status', '=', 'approved')]}"/>
                        <field name="reject_date" attrs="{'required': [('pss_status', '=', 'rejected')]}"/>
                        <field name="reason_reject" attrs="{'required': [('pss_status', '=', 'rejected')]}"/>
                        <field name="buyer_ref"/>
                        <field name="note"/>
                        <field name="buyer_comment"/>
                        <field name="comment"/>
                        <field name="inspector"/>
                        <field name="qc_staff_id"/>
                        <field name="stack" widget="many2many_tags"/>
