<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_plan_form_chatter" model="ir.ui.view">
        <field name="name">production.plan.form.chatter</field>
        <field name="model">production.plan</field>
        <field name="inherit_id" ref="sd_india_report.view_production_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_stock_allocation_form_chatter" model="ir.ui.view">
        <field name="name">stock.allocation.form.chatter</field>
        <field name="model">stock.allocation</field>
        <field name="inherit_id" ref="sd_india_contract.stock_allocation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
