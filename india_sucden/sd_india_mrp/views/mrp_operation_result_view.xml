<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mrp_operation_result_form_inherit_india" model="ir.ui.view">
        <field name="name">view_mrp_operation_result_form_inherit_india</field>
        <field name="model">mrp.operation.result</field>
        <field name="inherit_id" ref="sd_mrp.view_mrp_operation_result_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='calendar_id']" position="replace">
            </xpath>
            <xpath expr="//field[@name='resource_id']" position="replace">
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <button name="button_confirm" states="draft" string="Done" type="object" class="oe_highlight" confirm="Are you sure to Confirm the Production Result?"/>
                <button name="button_cancel" states="draft,done" string="Cancel" type="object" confirm="Are you sure to cancel this Production Result?"/>
            </xpath>

            <xpath expr="//field[@name='produced_products']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>