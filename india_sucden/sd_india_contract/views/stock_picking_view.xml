<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form_inherit_india" model="ir.ui.view">
        <field name="name">view_picking_form_inherit_india</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="print_output_return" string="Print Output Return" type="object" class="oe_highlight" attrs="{'invisible': [('picking_type_code', '!=', 'return_supplier')]}"/>
            </xpath>
        </field>
    </record>
</odoo>