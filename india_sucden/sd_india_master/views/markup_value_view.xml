<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_markup_value_tree_india" model="ir.ui.view">
            <field name="name">view_markup_value_tree_india</field>
            <field name="model">markup.value</field>
            <field name="arch" type="xml">
                <tree string="Markup Value" editable="top" default_order="id desc">
                	<field name="name"/>
                	<field name="from_date"/>
                	<field name="to_date"/>
                	<field name="value"/>
                </tree>
            </field>
        </record>

    <record id="action_markup_value_india" model="ir.actions.act_window">
            <field name="name">Markup Value</field>
            <field name="res_model">markup.value</field>
            <field name="view_mode">tree</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
              		Create a Markup Value, the first step of a new Markup Value
              </p>
            </field>
        </record>
    <menuitem id="menu_markup_value"
            name="Markup Value"
            action="action_markup_value_india"
            parent="sd_master.menu_master_data_sucden_root"
            sequence="110"/>
</odoo>