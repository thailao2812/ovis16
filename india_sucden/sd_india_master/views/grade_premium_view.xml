<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_grade_premium_tree_india" model="ir.ui.view">
            <field name="name">view_grade_premium_tree_india</field>
            <field name="model">grade.premium.india</field>
            <field name="arch" type="xml">
                <tree string="Grade Premium" editable="top" default_order="id desc">
                	<field name="name"/>
                	<field name="crop_id"/>
                	<field name="product_ids" widget="many2many_tags"/>
                	<field name="premium"/>
                </tree>
            </field>
        </record>

    <record id="action_grade_premium_india" model="ir.actions.act_window">
            <field name="name">Grade Premium</field>
            <field name="res_model">grade.premium.india</field>
            <field name="view_mode">tree</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
              		Create a Grade Premium, the first step of a new Grade Premium
              </p>
            </field>
        </record>

    <menuitem id="menu_grade_premium"
            name="Grade Premium"
            action="action_grade_premium_india"
            parent="sd_master.menu_master_data_sucden_root"
            sequence="111"/>
</odoo>