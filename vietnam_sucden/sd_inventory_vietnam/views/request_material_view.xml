        <field name="name">view_request_materials_tree_inherit_vietnam_sucden</field>
        <field name="model">request.materials</field>
        <field name="inherit_id" ref="sd_inventory.view_request_materials_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                 <attribute name="delete">false</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_request_materials_form_inherit_vietnam_sucden" model="ir.ui.view">
        <field name="name">view_request_materials_form_inherit_vietnam_sucden</field>
        <field name="model">request.materials</field>
        <field name="inherit_id" ref="sd_inventory.view_request_materials_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                 <attribute name="delete">false</attribute>
            </xpath>

        </field>
    </record>
</odoo>