<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="iotthinks_device_profile_tree_view" model="ir.ui.view">
            <field name="name">iotthinks.device.profile.tree</field>
            <field name="model">iotthinks.device.profile</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="country_id"/>
                    <field name="device_id"/>
                    <field name="key"/>
                    <field name="latest_download"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
        <record id="iotthinks_device_profile_form_view" model="ir.ui.view">
            <field name="name">iotthinks.device.profile.form</field>
            <field name="model">iotthinks.device.profile</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="country_id" options="{'no_create': True}" />
                            <field name="device_id"/>
                            <field name="key"/>
                            <field name="latest_download"/>
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_iotthinks_device_profile" model="ir.actions.act_window">
            <field name="name">Device Profiles</field>
            <field name="res_model">iotthinks.device.profile</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="search_view_id"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                        Create a Device Profiles, the first step of a new Device Profile List.
                </p>
            </field>
        </record>
        
        <record model="ir.actions.act_window.view" id="action_iotthinks_device_profile_tree">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="iotthinks_device_profile_tree_view"/>
            <field name="act_window_id" ref="action_iotthinks_device_profile"/>
        </record>
        
        <record model="ir.actions.act_window.view" id="action_iotthinks_device_profile_form">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="iotthinks_device_profile_form_view"/>
            <field name="act_window_id" ref="action_iotthinks_device_profile"/>
        </record>

    </data>
</odoo>