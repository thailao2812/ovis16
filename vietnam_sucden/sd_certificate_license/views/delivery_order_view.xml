<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_delivery_order_tree_inherit_sd_certificate" model="ir.ui.view">
        <field name="name">view_delivery_order_tree_inherit_sd_certificate</field>
        <field name="model">delivery.order</field>
        <field name="inherit_id" ref="sd_sale_contract.view_delivery_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='certificate_id']" position="after">
                <!-- <field name="certificated_ids" widget="many2many_tags"/> -->
                <field name="certificate_list"/>
                <field name="factory_etd"/>
            </xpath>
            <xpath expr="//field[@name='certificate_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_delivery_order_form_inherit_sd_certificate" model="ir.ui.view">
        <field name="name">view_delivery_order_form_inherit_sd_certificate</field>
        <field name="model">delivery.order</field>
        <field name="inherit_id" ref="sd_sale_contract.view_delivery_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shipping_id']" position="after">
                <field name="certificated_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='delivery_order_ids']/tree/field[@name='certificate_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='warehouse_id']" position="attributes">
                <attribute name="attrs">{'invisible': [('type', '=', 'Sale')]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>