<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_contract_form_inherit_sd_certificate" model="ir.ui.view">
        <field name="name">view_purchase_contract_form_inherit_sd_certificate</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_purchase_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_id']" position="attributes">
                <attribute name="domain">[('partner_id', '=', partner_id), 
                    ('state', '=', 'active'), ('crop_id', '=', crop_id)]
                </attribute>
                <attribute name="context">{}</attribute>
            </xpath>
            <xpath expr="//field[@name='certificate_id']" position="after">
                <field name="license_id" position="move"/>
                <label for="certificated_ids"/>
                <div name="certificated_ids" class="o_row">
                    <field name="certificated_ids" widget="many2many" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_write': True, 'no_create': True, 'no_open': True}">
                        <tree>
                            <field name="name"/>
                            <field name="premium"/>
                            <field name="active"/>
                        </tree>
                    </field>
                </div>
            </xpath>
            <xpath expr="//field[@name='certificate_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_nvp_contract_tree_inherit_sd_certificate" model="ir.ui.view">
        <field name="name">view_nvp_contract_tree_inherit_sd_certificate</field>
