<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_revert" model="ir.ui.view">
        <field name="name">sale.subscription.revert</field>
        <field name="model">sale.subscription.revert</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <separator string="Comment"/>
                    <div>
                        <field name="name" placeholder="Comment" colspan="4"/>
                    </div>
                    
                </sheet>
                <footer>
                    <button name="approve" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
