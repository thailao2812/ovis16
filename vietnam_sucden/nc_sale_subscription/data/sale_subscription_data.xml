    <record id="subscription_followers_read_write_own" model="ir.rule">
        <field name="name">proposal.followers: write its own</field>
        <field name="model_id" ref="model_sale_subscription"/>
        <field name="groups" eval="[(4, ref('sale_subscription.group_sale_subscription_view')), (4, ref('nc_sale_subscription.group_sale_subscription_approve')), (4, ref('nc_sale_subscription.group_sale_subscription_create'))]"/>
        <field name="domain_force">['|', ('message_follower_ids.partner_id', '=' , user.partner_id.id),('create_uid','=',user.id)]</field>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
    </record>

    <record id="subscription_followers_read_write_all" model="ir.rule">
        <field name="name">proposal.followers: write all</field>
        <field name="model_id" ref="model_sale_subscription"/>
        <field name="groups" eval="[(4, ref('sale_subscription.group_sale_subscription_manager'))]"/>
        <field name="domain_force">[(1, '=' , 1)]</field>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
    </record>
    
</odoo>
