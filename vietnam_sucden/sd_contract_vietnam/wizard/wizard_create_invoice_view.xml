<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_create_invoice" model="ir.ui.view">
        <field name="name">view_create_invoice</field>
        <field name="model">wizard.create.invoice</field>
        <field name="arch" type="xml">
             <form string="Create Invoice">
                <group>
					<field name="is_converted" invisible="1"/>
					<field name="invoice_converted_ids" widget="many2many_tags" invisible="1"/>
					<field name="invoice_origin_id" options="{'no_create': True}" attrs="{'invisible': [('is_converted', '=', False)], 'required': [('is_converted', '=', True)]}" domain="[('id', 'in', invoice_converted_ids)]"/>
					<field name="contract_id" invisible="1" readonly="1"/>
					<field name="type" invisible="1"/>
					<field name="journal_id" readonly="1"/>
					<field name="invoice_number" required="1"/>
					<field name="invoice_denominator" required="1"/>
					<field name="date" required="1"/>
					<field name="amount_different" attrs="{'invisible': [('is_converted', '=', False)]}"/>
					<field name="price_unit" attrs="{'invisible': [('type', '=', 'purchase')]}"/>
					<field name="quantity" attrs="{'invisible': [('is_converted', '=', True)]}"/>
                </group>
                <group>
                </group>
                <footer>
                    <button name="action_confirm" string="Create Invoice" type="object"
                        class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <record id="action_create_invoice" model="ir.actions.act_window">
            <field name="name">Create Invoice</field>
            <field name="res_model">wizard.create.invoice</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_create_invoice"/>
            <field name="target">new</field>
        </record>
</odoo>