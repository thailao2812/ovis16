<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="e_invoicing_form_inherit_account_move_inherit_sd_contract_vietnam" model="ir.ui.view">
        <field name="name">e_invoicing_form_inherit_account_move_inherit_sd_contract_vietnam</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="sd_electronic.e_invoicing_form_inherit_account_move"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="purchase_contract_id" readonly="1"/>
                <field name="user_approve" options="{'no_create': True}" domain="[('trader', '=', True)]"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']" position="after">
                <page string="Purchase Allocate" name="purchase_allocate">
                    <field name="purchase_contract_invoice_ids" readonly="1">
                        <tree>
                            <field name="purchase_contract_id"/>
                            <field name="date"/>
                            <field name="amount_allocated_untaxed"/>
                            <field name="amount_allocated_tax"/>
                            <field name="amount_allocated_total"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="invoice_denominator" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='reference_description']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group string="Allocated Amount Information">
                    <group>
                        <field name="attachment_ids" widget="many2many_attachment_preview" string="Attach a file"/>
                        <field name="total_quantity"/>
                        <field name="total_allocated_amount" string="Total Quantity Allocate from GRN to Invoice"/>
                        <field name="amount_tax"/>
                    </group>
                    <group>
                        <field name="remain_quantity"/>
                        <field name="remain_taxed_amount"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_approve" string="Approve" attrs="{'invisible': &quot;['|', ('user_approve', '!=', uid), ('state', '!=', 'draft')]&quot;}" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='e_invoicing']" position="attributes">
                 <attribute name="groups">sd_contract_vietnam.group_billing_account</attribute>
            </xpath>
            <xpath expr="//button[@name='print_preview_invoice']" position="attributes">
                 <attribute name="groups">sd_contract_vietnam.group_billing_account</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="groups">sd_contract_vietnam.group_billing_account</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('move_type', '=', 'entry'), ('state','!=', 'approved')]}</attribute>
                <attribute name="states"></attribute>
                <attribute name="groups">sd_contract_vietnam.group_billing_account</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="button_draft" string="Reject" type="object" groups="sd_contract_vietnam.group_billing_account" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
            </xpath>
        </field>
    </record>

    <record id="api_restful_inherit_sucden_vietnam_contract" model="ir.ui.view">
        <field name="name">api_restful_inherit_sucden_vietnam_contract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="api_restful.view_move_form_inherit_reach"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_api_restful_token']" position="attributes">
                 <attribute name="groups">sd_contract_vietnam.group_billing_account</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_inherit_sd_contract_vietnam" model="ir.ui.view">
        <field name="name">view_invoice_tree_inherit_sd_contract_vietnam</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="product_id"/>
                <field name="price_unit"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="before">
                <field name="purchase_contract_id"/>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="replace">
                <field name="total_quantity"/>
                <field name="total_allocated_amount"/>
                <field name="remain_taxed_amount"/>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed_signed']" position="replace">
                <field name="amount_untaxed"/>
            </xpath>
            <xpath expr="//field[@name='amount_tax_signed']" position="replace">
                <field name="amount_tax"/>
            </xpath>
            <xpath expr="//field[@name='amount_total_signed']" position="replace">
                <field name="amount_total"/>
                <field name="amount_residual"/>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="replace">
            </xpath>
            <xpath expr="//field[@name='amount_residual_signed']" position="replace">
            </xpath>
        </field>
    </record>
</odoo>