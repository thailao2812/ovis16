<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_contract_form_inherit_vietnam" model="ir.ui.view">
        <field name="name">view_purchase_contract_form_inherit_vietnam</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_purchase_contract_form"/>
        <field name="arch" type="xml">
			 <xpath expr="//page[@name='information']" position="after">
            	<page name="farmer" string="Farmer Information">
                    <field name="list_farmer" readonly="1">
                        <tree editable="1" limit="100">
                            <field name="date"/>
                            <field name="farmer_id"/>
                            <field name="farmer_code"/>
                            <field name="quantity" sum="quantity"/>
                        </tree>
                    </field>

                </page>
            </xpath>
            <xpath expr="//field[@name='contract_line']//tree//field[@name='difams']" position="after">
                <field name="equiv_faq_price"/>
            </xpath>
            <xpath expr="//field[@name='premium']" position="after">
<!--                <field name="deposit_amount"/>-->
                <field name="print_company"/>
            </xpath>
            <xpath expr="//field[@name='license_id']" position="after">
                <field name="license_2nd_id"/>
                <field name="state_final_payment" widget="badge" readonly="1" invisble="1"/>
            </xpath>
            <xpath expr="//div[@class='oe_button_box']" position="before">
                <widget name="web_ribbon" title="Final Payment" attrs="{'invisible': [('state_final_payment', '!=', 'paid')]}" groups="sd_contract_vietnam.group_request_final_payment,sd_contract_vietnam.group_approve_final_payment,sd_contract_vietnam.group_director_approve_final_payment"/>
            </xpath>
            <xpath expr="//button[@name='button_approve']" position="after">
                <button name="print_final_payment" string="Print Final Payment" type="object" attrs="{'invisible': ['|', ('state', '!=', 'approved'), ('state_final_payment', '!=', 'draft')]}"/>
                <button name="button_request_final_payment"
                    string="Request Final Payment"
                    type="object"
                    attrs="{'invisible': ['|', ('state', '!=', 'approved'), ('state_final_payment', '!=', 'draft')]}"
                    groups="sd_contract_vietnam.group_request_final_payment"/>

                 <button name="button_approve_final_payment"
                    string="Approve Final Payment"
                    type="object"
                    attrs="{'invisible': [('state_final_payment', '!=', 'request')]}"
                    groups="sd_contract_vietnam.group_approve_final_payment"/>

            <button name="button_approve_director_final_payment"
                    string="Director Approve Final Payment"
                    type="object"
                    attrs="{'invisible': [('state_final_payment', '!=', 'approve')]}"
                    groups="sd_contract_vietnam.group_director_approve_final_payment"/>
                <button name="button_paid_final_payment" string="Paid Final Payment" type="object" attrs="{'invisible': [('state_final_payment', '!=', 'director')]}" groups="account.group_account_invoice"/>
<!--                <button name="button_done" type="object" string="Thanh lý hợp đồng" class="oe_highlight" attrs="{'invisible': ['|', ('state_final_payment', '!=', 'paid'), ('state', '!=', 'approved')]}"/>-->
            </xpath>
            <xpath expr="//button[@name='compute_amount']" position="replace">

            </xpath>
            <xpath expr="//field[@name='according_id']" position="after">
                <field name="according_final_payment_id" groups="sd_contract_vietnam.group_request_final_payment,sd_contract_vietnam.group_approve_final_payment,sd_contract_vietnam.group_director_approve_final_payment"/>
            </xpath>
            <xpath expr="//page[@name='invoice']" position="replace">

            </xpath>
            <xpath expr="//page[@name='product']" position="after">
                <page string="Invoice" name="invoice_supplier">
                    <field name="invoice_lines_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="total_amount"/>
                            <field name="tax"/>
                            <field name="total_amount_tax"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//button[@name='printf_nvp']" position="attributes">
                <attribute name="attrs">{'invisible': [('origin', '!=', False)]}</attribute>
                <attribute name="string">Print SVNP PDF</attribute>
            </xpath>

            <xpath expr="//button[@name='button_approve']" position="after">
                <button name="print_nvp_npe" string="Print SVNP From NPE PDF" type="object" class="oe_highlight" attrs="{'invisible': [('origin', '=', False)]}"/>
                <button name="print_nvp_npe_word" string="Print SVNP From NPE WORDS" type="object" class="oe_highlight" attrs="{'invisible': [('origin', '=', False)]}"/>
                <button name="print_nvp_word" string="Print SVNP WORDS" type="object" class="oe_highlight" attrs="{'invisible': [('origin', '!=', False)]}"/>
            </xpath>

        </field>
    </record>
    <record id="view_ptbf_contract_form_inherit_vietnam" model="ir.ui.view">
        <field name="name">view_ptbf_contract_form_inherit_vietnam</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_ptbf_contract_form"/>
        <field name="arch" type="xml">
			 <xpath expr="//page[@name='information']" position="after">
            	<page name="farmer" string="Farmer Information">
                    <field name="list_farmer" readonly="1">
                        <tree editable="1" limit="100">
                            <field name="date"/>
                            <field name="farmer_id"/>
                            <field name="farmer_code"/>
                            <field name="quantity" sum="quantity"/>
                        </tree>
                    </field>

                </page>
            </xpath>
            <xpath expr="//field[@name='contract_line']//tree//field[@name='difams']" position="after">
                <field name="equiv_faq_price"/>
            </xpath>

            <xpath expr="//field[@name='ptbf_ids']//form//field[@name='diff']" position="after">
                <field name="contract_p_id"/>
            </xpath>
            <xpath expr="//field[@name='ptbf_ids']//tree//field[@name='date_fix']" position="after">
                <field name="contract_p_id"/>
            </xpath>
            <xpath expr="//field[@name='premium']" position="after">
                <field name="print_company"/>
            </xpath>
            <xpath expr="//field[@name='premium']" position="before">
                <field name="percent_advance_price"/>
            </xpath>
            <xpath expr="//field[@name='license_id']" position="after">
                <field name="license_2nd_id"/>
                <field name="state_final_payment" widget="badge" readonly="1" invisble="1"/>
            </xpath>
            <xpath expr="//div[@class='oe_button_box']" position="before">
