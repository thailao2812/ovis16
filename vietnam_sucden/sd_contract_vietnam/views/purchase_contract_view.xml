            </xpath>
            <xpath expr="//button[@name='button_approve']" position="after">
                <button name="button_request_final_payment"
                    string="Request Final Payment"
                    type="object"
                    attrs="{'invisible': ['|', ('state', '!=', 'approved'), ('state_final_payment', '!=', 'draft')]}"
                    groups="sd_contract_vietnam.group_request_final_payment"/>

                 <button name="button_approve_final_payment"
                    string="Approve Final Payment"
                    type="object"
                    attrs="{'invisible': [('state_final_payment', '!=', 'request')]}"
                    groups="sd_contract_vietnam.group_approve_final_payment"/>

            <button name="button_approve_director_final_payment"
                    string="Director Approve Final Payment"
                    type="object"
                    attrs="{'invisible': [('state_final_payment', '!=', 'approve')]}"
                    groups="sd_contract_vietnam.group_director_approve_final_payment"/>
                <button name="button_paid_final_payment" string="Paid Final Payment" type="object" attrs="{'invisible': [('state_final_payment', '!=', 'director')]}"/>
            </xpath>
            <xpath expr="//field[@name='according_id']" position="after">
                <field name="according_final_payment_id" groups="sd_contract_vietnam.group_request_final_payment,sd_contract_vietnam.group_approve_final_payment,sd_contract_vietnam.group_director_approve_final_payment"/>
            </xpath>
            <xpath expr="//page[@name='product']" position="after">
                <page string="Invoice" name="invoice_supplier">
                    <field name="invoice_lines_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="total_amount"/>
                            <field name="tax"/>
                            <field name="total_amount_tax"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//button[@name='print_contract_ptbf']" position="attributes">
                <attribute name="string">Print PTBF PDF</attribute>
            </xpath>
            <xpath expr="//button[@name='print_contract_ptbf']" position="after">
                <button name="print_ptbf_word" string="Print PTBF WORD" type="object" class="oe_highlight"/>
            </xpath>
        </field>
    </record>

    <record id="view_consignment_agreement_form_inherit_vietnam" model="ir.ui.view">
        <field name="name">view_consignment_agreement_form_inherit_vietnam</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_consignment_agreement_form"/>
        <field name="arch" type="xml">
			 <xpath expr="//page[@name='information']" position="after">
            	<page name="farmer" string="Farmer Information">
                    <field name="list_farmer" readonly="1">
                        <tree editable="1" limit="100">
                            <field name="date"/>
                            <field name="farmer_id"/>
                            <field name="farmer_code"/>
                            <field name="quantity" sum="quantity"/>
                        </tree>
                    </field>

                </page>
            </xpath>
            <xpath expr="//field[@name='interest']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='premium']" position="after">
                <field name="print_company"/>
            </xpath>

            <xpath expr="//field[@name='license_id']" position="after">
                <field name="license_2nd_id"/>
            </xpath>
            <xpath expr="//page[@name='invoice']" position="replace">
            </xpath>
            <xpath expr="//button[@name='printf_npe']" position="after">
                <button name="print_npe_word" string="Print NPE WORD" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_force_close_npe" class="oe_highlight" string="Force Close" type="object" attrs="{'invisible': [('state', 'in', ['draft', 'done', 'cancel'])]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_nvp_contract_allocation_invoiced_tree_inherit_vietnam" model="ir.ui.view">
        <field name="name">view_nvp_contract_allocation_invoiced_tree_inherit_vietnam</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_nvp_contract_allocation_invoiced_tree"/>
        <field name="arch" type="xml">
			 <xpath expr="//field[@name='deadline_date']" position="after">
                 <field name="equiv_faq_price"/>
            </xpath>

        </field>
    </record>
    <record id="view_purchase_contract_tree_inherit_vietnam" model="ir.ui.view">
        <field name="name">view_purchase_contract_tree_inherit_vietnam</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_purchase_contract_tree"/>
        <field name="arch" type="xml">
			 <xpath expr="//field[@name='product_id']" position="after">
                 <field name="interest"/>
            </xpath>

        </field>
    </record>

    <record id="view_nvp_contract_tree_inherit_vietnam" model="ir.ui.view">
        <field name="name">view_nvp_contract_tree_inherit_vietnam</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_nvp_contract_tree"/>
        <field name="arch" type="xml">
			 <xpath expr="//field[@name='state']" position="after">
                 <field name="state_final_payment" widget="badge"/>
            </xpath>
            <xpath expr="//tree" position="attributes">
                 <attribute name="decoration-success">state_final_payment == 'paid'</attribute>
            </xpath>
            <xpath expr="//field[@name='diff_price']" position="after">
                <field name="difams"/>
            </xpath>

        </field>
    </record>

    <record id="view_ptbf_contract_tree_inherit_vietnam" model="ir.ui.view">
        <field name="name">view_ptbf_contract_tree_inherit_vietnam</field>
        <field name="model">purchase.contract</field>
        <field name="inherit_id" ref="sd_purchase_contract.view_ptbf_contract_tree"/>
        <field name="arch" type="xml">
			 <xpath expr="//field[@name='state']" position="after">
                 <field name="state_final_payment" widget="badge"/>
            </xpath>
            <xpath expr="//tree" position="attributes">
                 <attribute name="decoration-success">state_final_payment == 'paid'</attribute>
            </xpath>
            <xpath expr="//field[@name='diff_price']" position="after">
                <field name="difams"/>
            </xpath>

        </field>
    </record>
</odoo>