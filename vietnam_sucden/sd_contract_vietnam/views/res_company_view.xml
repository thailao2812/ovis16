<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_inherit_sucden_vn_sucden" model="ir.ui.view">
            <field name="name">view_company_form_inherit_sucden_vn_sucden</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="stock_account_coffee_id"/>
                    <field name="stock_account_consumable_id"/>
                </xpath>
            </field>
    </record>
</odoo>