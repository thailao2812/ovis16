<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pss_management_inherit_sd_quality_vn" model="ir.ui.view">
        <field name="name">view_pss_management_inherit_sd_quality_vn</field>
        <field name="model">pss.management</field>
        <field name="inherit_id" ref="sd_quality.view_pss_management"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='buyer_ref']" position="after">
                <field name="license_id"/>
            </xpath>
        </field>
    </record>

    <record id="pss_management_action_duplicate" model="ir.actions.server">
        <field name="name">Duplicate Selected</field>
        <field name="model_id" ref="model_pss_management"/>
        <field name="binding_model_id" ref="model_pss_management"/>
        <field name="state">code</field>
        <field name="code">
            for record in records:
                record.copy()
        </field>
        <field name="binding_type">action</field>
    </record>
</odoo>
