<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_inherit_sucden_vietnam" model="ir.ui.view">
		<field name="name">view_move_form_inherit_sucden_vietnam</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//page[@name='aml_tab']" position="after">
                <page string="Request Payment" name="request_payment">
                    <field name="request_payment_invoice_ids" readonly="1">
                        <tree>
                            <field name="request_payment_id"/>
                            <field name="tax_amount" string="Allocated Tax Amount"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
                <page string="GRN Allocate" name="grn_allocate">
                    <field name="stock_picking_ids" readonly="1">
                        <tree>
                            <field name="picking_id"/>
                            <field name="contract_id"/>
                            <field name="allocated_qty" string="Allocated Contract Quantity"/>
                            <field name="allocated_amount" string="Current Allocated Invoice Quantity"/>
                        </tree>
                    </field>
                </page>
			</xpath>
        </field>
	</record>
</odoo>